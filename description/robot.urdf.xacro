<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- Constants for robot mechanical parameters -->
    <xacro:property name="PI" value="3.1415926535897931"/>
    <xacro:property name="chassis_mass" value="1.074"/>
    <xacro:property name="chassis_height" value="0.04"/>
    <xacro:property name="robot_height" value="0.053"/>
    <xacro:property name="wheel_mass" value="0.105" />
    <xacro:property name="wheel_radius" value="0.0508" />
    
    <!-- The chassis radius plus half the wheel thickness equals the robot radius -->
    <xacro:property name="chassis_radius" value="0.085"/>
    <xacro:property name="wheel_thickness" value="0.01905" />

    <xacro:include filename="$(find omni)/description/wheel.urdf.xacro"/>
    <xacro:include filename="$(find omni)/description/materials.urdf.xacro"/>
    <xacro:include filename="$(find omni)/description/ros2_control.urdf.xacro"/>
    <xacro:include filename="$(find omni)/description/gazebo.urdf.xacro"/>
    
    <!-- Simulation argument -->
    <xacro:arg name="use_sim" default="false"/>
    
    <link name="base_link"></link>

    <joint name="base_link_joint" type="fixed">
        <origin xyz="0 0 ${robot_height}" rpy="0 0 0" />
        <parent link="base_link"/>
        <child link="chassis_link" />
    </joint>

    <link name="chassis_link">
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
            </geometry>
            <material name="blue"/>
        </collision>

        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.634"/>
            <inertia ixx="0.00316977667"
                        ixy="0.0"
                        ixz="0.0"
                        iyy="0.00316977667"
                        iyz="0.0"
                        izz="0.005903752"/>
        </inertial>
    </link>

    <!-- THREE OMNI WHEELS at 120° intervals -->
    <!-- Wheel 1: Rear (180 degrees) -->
    <xacro:wheel parent="chassis_link" suffix="1" theta="${PI}"/>
    
    <!-- Wheel 2: Front Right (-60 degrees) -->
    <xacro:wheel parent="chassis_link" suffix="2" theta="${-PI/3}"/>
    
    <!-- Wheel 3: Front Left (60 degrees) -->
    <xacro:wheel parent="chassis_link" suffix="3" theta="${PI/3}"/>

    <!-- ROS2 Control Integration -->
    <xacro:omni_ros2_control name="OmniWheelSystem" prefix="" 
                             use_sim="$(arg use_sim)" 
                             use_fake_hardware="false"/>

    <!-- Gazebo plugins -->
    <xacro:omni_gazebo name="omni_robot"/>

</robot>
